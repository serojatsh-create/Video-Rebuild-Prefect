        "hard_cut",
        "fade",
        "slide",
        "scale",
        "rotate",
        "mask_reveal",
        "wipe",
        "type_on",
        "blur",
        "flash",
        "morph",
        "camera_push",
        "camera_pan",
        "hold",
        "composite",
        "unknown"
      ],
      "title": "AnimationEffect",
      "type": "string"
